<Window x:Class="GoFit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GoFit"
        Height="900" Width="1320"
        MinHeight="560" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GoFitBackground}">

    <Grid>
        <!-- Ladeanzeige, bis WebView2 bereit ist -->
        <StackPanel x:Name="SplashPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="GoFit"
                       FontSize="42" FontWeight="Bold"
                       Foreground="{StaticResource GoFitNeon}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="SplashText"
                       Text="wird gestartet …"
                       FontSize="13" Margin="0,10,0,0"
                       Foreground="{StaticResource GoFitMuted}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="520" />
        </StackPanel>

        <wv2:WebView2 x:Name="Web"
                      Visibility="Collapsed"
                      DefaultBackgroundColor="#05070A" />
    </Grid>
</Window>
